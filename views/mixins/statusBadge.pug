//- Insignia de color según el estado de un pedido (Order.status / Order.ORDER_STATUSES).
mixin statusBadge(status)
  -
    var badgeClass = {
      PENDING: 'text-bg-light',
      PAID: 'text-bg-info',
      SHIPPED: 'text-bg-primary',
      DELIVERED: 'text-bg-success',
      CANCELLED: 'text-bg-danger'
    }[status] || 'text-bg-secondary';
  span.badge(class=badgeClass)= __('admin.orders.status.' + status)
