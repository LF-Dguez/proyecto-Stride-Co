//- Insignia de color según el estado de un pedido (statusHistory.at(-1).status).
mixin statusBadge(status)
  -
    var badgeClass = {
      Creado: 'text-bg-light',
      Confirmado: 'text-bg-info',
      Preparando: 'text-bg-warning',
      Enviado: 'text-bg-primary',
      Entregado: 'text-bg-success',
      Cancelado: 'text-bg-danger'
    }[status] || 'text-bg-secondary';
  span.badge(class=badgeClass)= status
