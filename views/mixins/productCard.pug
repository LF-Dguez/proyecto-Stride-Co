//- Tarjeta de producto de la tienda, fiel al prototipo (shoe-art con color de fondo).
//- product = { id, name, brand, category, priceLabel, color, emoji }
mixin productCard(product)
  .col-sm-6.col-lg-3
    a.text-decoration-none.text-reset(href=`/products/${product.id}`)
      .product-tile
        .shoe-art(style=`background:${product.color || '#edf0f1'}`)
          span.tag.badge.text-bg-light= product.category
          span.shoe= product.emoji || '👟'
        .p-3
          .tiny= product.brand
          h5.fw-bold.my-1= product.name
          .d-flex.justify-content-between.align-items-center
            strong= product.priceLabel
            span.text-decoration-underline.tiny
              = __('store.catalog.viewDetail')
              i.bi.bi-arrow-up-right.ms-1
