extends ../layouts/store
include ../mixins/productCard

block content
  .container.py-5
    .d-flex.justify-content-between.align-items-center.flex-wrap.gap-3.mb-4
      div
        span.tiny.text-uppercase.fw-bold Stride-Co / #{__('store.nav.products')}
        h2.fw-bold.mb-0= __('store.catalog.title')
      form.d-flex.gap-2(method='get', action='/products')
        input.form-control(type='text', name='q', value=q, placeholder=__('store.catalog.search'))
        select.form-select(name='category', onchange='this.form.submit()')
          option(value='')= __('store.catalog.allCategories')
          each label, id in categories
            option(value=id, selected=String(id) === String(category))= label
        button.btn.btn-dark(type='submit')= __('common.search')
    .row.g-4
      if products.length
        each product in products
          +productCard(product)
      else
        p.text-secondary= __('store.catalog.empty')
    include ../partials/pagination
