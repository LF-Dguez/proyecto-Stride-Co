extends ../../layouts/admin
include ../../mixins/table
include ../../mixins/statusBadge

block content
  .row.g-4
    .col-lg-7
      .store-panel.mb-4
        .d-flex.justify-content-between.align-items-center.mb-3
          h5.fw-bold.mb-0= __('admin.orders.customer')
          +statusBadge(order.status)
        p.mb-1= order.email || '—'
        p.text-secondary.mb-0= order.phone || ''
        if order.address
          hr
          p.mb-0.text-secondary
            = [order.address.street, order.address.number, order.address.city, order.address.state, order.address.postalCode, order.address.country].filter(Boolean).join(', ')

      .store-panel.mb-4
        h5.fw-bold.mb-3= __('admin.orders.items')
        +table([__('admin.orders.col.product'), __('admin.orders.col.quantity'), __('admin.orders.col.unitPrice')])
          each item in order.items
            tr
              td= item.productName
              td= item.quantity
              td= item.unitPriceLabel
        .d-flex.justify-content-end.mt-3
          table.table.table-sm.w-auto
            tr
              td.text-secondary.pe-4= __('admin.orders.subtotal')
              td.text-end= order.totals.subtotalLabel
            tr
              td.text-secondary.pe-4= __('admin.orders.shipping')
              td.text-end= order.totals.shippingLabel
            tr
              td.text-secondary.pe-4= __('admin.orders.discount')
              td.text-end= order.totals.discountLabel
            tr
              td.fw-bold.pe-4= __('admin.orders.total')
              td.text-end.fw-bold= order.totals.totalLabel

      .store-panel
        h5.fw-bold.mb-3= __('admin.orders.history')
        if order.history.length
          ul.list-unstyled.mb-0
            each entry in order.history
              li.mb-2
                +statusBadge(entry.status)
                span.ms-2.tiny= entry.dateLabel
                if entry.note
                  div.text-secondary.tiny= entry.note
        else
          p.text-secondary.mb-0= __('admin.orders.noHistory')

    .col-lg-5
      if can('orders', 'update', 'any')
        .store-panel
          h5.fw-bold.mb-3= __('admin.orders.changeStatus')
          form(method='post', action=`/admin/orders/${order.id}/status`)
            .mb-3
              label.form-label(for='status')= __('admin.orders.field.newStatus')
              select#status.form-select(name='status')
                each s in statuses
                  option(value=s, selected=s === order.status)= __('admin.orders.status.' + s)
            .mb-3
              label.form-label(for='note')= __('admin.orders.field.note')
              textarea#note.form-control(name='note', rows='3')
            button.btn.btn-lime.w-100(type='submit')= __('admin.orders.updateStatus')
