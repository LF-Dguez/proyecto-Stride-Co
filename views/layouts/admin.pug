doctype html
html(lang=getLocale())
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title= title + ' · Stride-Co'
    link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css', rel='stylesheet')
    link(href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css', rel='stylesheet')
    link(href='/css/stride.css', rel='stylesheet')
  body
    aside.admin-sidebar
      .brand.text-white.px-3.mb-3
        | STRIDE
        span -CO
      div.sidebar-label.text-uppercase.tiny.px-3.mb-3= __('admin.nav.dashboard')
      nav.nav.flex-column
        a.nav-link(class=activeNav === 'dashboard' ? 'active' : '', href='/admin')
          i.bi.bi-grid.me-2
          = __('admin.nav.dashboard')
        a.nav-link(class=activeNav === 'products' ? 'active' : '', href='/admin/products')
          i.bi.bi-box-seam.me-2
          = __('admin.nav.products')
        a.nav-link(class=activeNav === 'variants' ? 'active' : '', href='/admin/variants')
          i.bi.bi-tags.me-2
          = __('admin.nav.variants')
        a.nav-link(class=activeNav === 'inventory' ? 'active' : '', href='/admin/inventory')
          i.bi.bi-stack.me-2
          = __('admin.nav.inventory')
        a.nav-link(class=activeNav === 'orders' ? 'active' : '', href='/admin/orders')
          i.bi.bi-receipt.me-2
          = __('admin.nav.orders')
        a.nav-link(class=activeNav === 'customers' ? 'active' : '', href='/admin/customers')
          i.bi.bi-people.me-2
          = __('admin.nav.customers')
        hr.border-secondary
        a.nav-link(class=activeNav === 'users' ? 'active' : '', href='/admin/users')
          i.bi.bi-person-badge.me-2
          = __('admin.nav.users')
        a.nav-link(class=activeNav === 'roles' ? 'active' : '', href='/admin/roles')
          i.bi.bi-key.me-2
          = __('admin.nav.roles')
      .mt-4.px-2
        a.btn.btn-outline-light.w-100.btn-sm(href='/')
          i.bi.bi-shop.me-1
          = __('admin.viewStore')
    main.admin-main
      .admin-top
        div
          .tiny Stride-Co / #{__('admin.nav.dashboard')}
          h2.fw-bold.mb-0= title
        div
          a.btn.btn-outline-secondary.btn-sm(href='/logout')
            = __('admin.logout')
            i.bi.bi-box-arrow-right.ms-1
      include ../partials/flash.pug
      block content
