# Puerto del servidor
PORT=3000

# MySQL (Sequelize)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stride_co
DB_USER=root
DB_PASSWORD=

# MongoDB (Mongoose)
MONGO_URI=mongodb://localhost:27017/stride_co

# Autenticación (JWT) - Actividad 4
# JWT_SECRET: clave para firmar los tokens. NO escribir el valor real en el repositorio.
# Generar una local con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_ISSUER=stride-co
JWT_AUDIENCE=stride-co-api

# bcrypt: factor de costo (salt rounds)
BCRYPT_SALT_ROUNDS=10
